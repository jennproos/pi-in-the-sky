{
  "name": "pi-in-the-sky",
  "version": "1.0.0",
  "description": "Family wall calendar for a Raspberry Pi kiosk",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "NODE_ENV=production node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "date-fns": "^4.4.0",
    "fastify": "^5.12.8",
    "ical.js": "^2.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
